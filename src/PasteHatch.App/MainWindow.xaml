<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PasteHatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="PasteHatch">

    <!-- Three columns: basket rail, one file tree, preview. Default Fluent controls only. -->
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragEnter="OnRootDragEnter"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAcceleratorInvoked" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="OnCutAcceleratorInvoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewBasketAcceleratorInvoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseBasketAcceleratorInvoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="OnNewFolderAcceleratorInvoked" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAcceleratorInvoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAcceleratorInvoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Control,Shift" Invoked="OnMoveBasketUpAcceleratorInvoked" />
            <KeyboardAccelerator Key="Down" Modifiers="Control,Shift" Invoked="OnMoveBasketDownAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="OnBasketNumberAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="BasketCommandBar"
            Grid.Row="0"
            Margin="8,4,8,0"
            DefaultLabelPosition="Right"
            IsOpen="False"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton
                x:Name="PasteButton"
                Click="OnPasteClick"
                Icon="Paste"
                Label="{Binding [Command_Paste], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [ToolTip_Paste], Source={StaticResource Loc}}" />
            <AppBarButton
                x:Name="NewFolderButton"
                Click="OnNewFolderClick"
                Icon="Add"
                Label="{Binding [Command_NewFolder], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [ToolTip_NewFolder], Source={StaticResource Loc}}" />
            <AppBarButton
                x:Name="OpenFolderButton"
                Click="OnOpenFolderClick"
                Icon="Folder"
                Label="{Binding [Command_OpenFolder], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [ToolTip_OpenFolder], Source={StaticResource Loc}}" />
            <AppBarButton
                x:Name="CopyPathButton"
                Click="OnCopyPathClick"
                Icon="Copy"
                Label="{Binding [Command_CopyPath], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [ToolTip_CopyPath], Source={StaticResource Loc}}" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="SettingsButton"
                Click="OnSettingsClick"
                Icon="Setting"
                Label="{Binding [Command_Settings], Source={StaticResource Loc}}" />
        </CommandBar>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="16,4,16,0" SizeChanged="OnWorkspaceSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="220" MinWidth="160" />
                <ColumnDefinition x:Name="RailSplitterColumn" Width="8" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="8" />
                <ColumnDefinition x:Name="PreviewColumn" Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,0,4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding [Header_Baskets], Source={StaticResource Loc}}" />
                    <Button
                        x:Name="AddBasketButton"
                        Grid.Column="1"
                        AutomationProperties.Name="{Binding [Action_CreateBasket], Source={StaticResource Loc}}"
                        Click="OnAddBasketClick"
                        ToolTipService.ToolTip="{Binding [ToolTip_CreateBasket], Source={StaticResource Loc}}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="BasketsList"
                    Grid.Row="1"
                    Padding="0,0,0,8"
                    AllowDrop="True"
                    AutomationProperties.Name="{Binding [Header_Baskets], Source={StaticResource Loc}}"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnBasketDragItemsCompleted"
                    DragItemsStarting="OnBasketDragItemsStarting"
                    IsItemClickEnabled="False"
                    ReorderMode="Enabled"
                    RightTapped="OnBasketRightTapped"
                    SelectionChanged="OnBasketSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                MinHeight="40"
                                Background="Transparent"
                                ColumnSpacing="4"
                                DoubleTapped="OnBasketRowDoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Visibility="{Binding NameVisibility}">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBox
                                    MinWidth="120"
                                    KeyDown="OnBasketRenameKeyDown"
                                    LostFocus="OnBasketRenameLostFocus"
                                    Text="{Binding EditText, Mode=TwoWay}"
                                    TextChanged="OnBasketRenameTextChanged"
                                    Visibility="{Binding EditVisibility}" />

                                <Button
                                    Grid.Column="1"
                                    Padding="6"
                                    AutomationProperties.Name="{Binding [Action_DeleteBasket], Source={StaticResource Loc}}"
                                    Click="OnCloseBasketClick"
                                    ToolTipService.ToolTip="{Binding [Action_DeleteBasket], Source={StaticResource Loc}}"
                                    Visibility="{Binding CloseVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid
                x:Name="RailSplitter"
                Grid.Column="1"
                Background="Transparent">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <primitives:Thumb
                    x:Name="RailSplitterThumb"
                    Background="Transparent"
                    BorderThickness="0"
                    DragDelta="OnRailSplitterDragDelta"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid
                Grid.Column="2"
                Margin="8,0,8,0"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="UpButton"
                        Padding="8,4"
                        AutomationProperties.Name="{Binding [Action_Up], Source={StaticResource Loc}}"
                        Click="OnUpClick"
                        ToolTipService.ToolTip="{Binding [ToolTip_Up], Source={StaticResource Loc}}"
                        VerticalAlignment="Stretch">
                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                    </Button>
                    <BreadcrumbBar
                        x:Name="FolderBreadcrumb"
                        Grid.Column="1"
                        AutomationProperties.Name="{Binding [Label_CurrentFolder], Source={StaticResource Loc}}"
                        ItemClicked="OnBreadcrumbItemClicked"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <TreeView
                        x:Name="FileTree"
                        AllowDrop="True"
                        AutomationProperties.Name="{Binding [Label_BasketFiles], Source={StaticResource Loc}}"
                        CanDragItems="True"
                        DragItemsCompleted="OnTreeDragItemsCompleted"
                        DragItemsStarting="OnTreeDragItemsStarting"
                        Expanding="OnTreeExpanding"
                        KeyDown="OnTreeKeyDown"
                        RightTapped="OnTreeRightTapped"
                        SelectionChanged="OnTreeSelectionChanged"
                        SelectionMode="Single">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemContainerTransitions>
                            <TransitionCollection />
                        </TreeView.ItemContainerTransitions>
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    MinHeight="40"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    DoubleTapped="OnTreeEntryDoubleTapped"
                                    DragOver="OnTreeEntryDragOver"
                                    Drop="OnTreeEntryDrop"
                                    PointerEntered="OnEntryPointerEntered"
                                    PointerExited="OnEntryPointerExited"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{Binding Content.Glyph}"
                                            VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <StackPanel
                                            Spacing="1"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Content.NameVisibility}">
                                            <TextBlock
                                                Text="{Binding Content.Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Content.SecondaryText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Content.EditVisibility}">
                                            <TextBox
                                                MinWidth="160"
                                                KeyDown="OnNodeRenameKeyDown"
                                                Text="{Binding Content.EditText, Mode=TwoWay}"
                                                TextChanged="OnNodeRenameTextChanged" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Content.Extension}"
                                                ToolTipService.ToolTip="{Binding [ToolTip_ExtensionFixed], Source={StaticResource Loc}}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                AutomationProperties.Name="{Binding [Action_SaveName], Source={StaticResource Loc}}"
                                                Click="OnNodeRenameSaveClick"
                                                Content="OK" />
                                            <Button
                                                AutomationProperties.Name="{Binding [Action_CancelRename], Source={StaticResource Loc}}"
                                                Click="OnNodeRenameCancelClick"
                                                Content="{Binding [Action_Cancel], Source={StaticResource Loc}}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Opacity="{Binding Content.ActionsOpacity}"
                                        Visibility="{Binding Content.NameVisibility}"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="EntryOpenButton"
                                            Width="32" Height="32" Padding="0"
                                            AutomationProperties.Name="{Binding [Action_Open], Source={StaticResource Loc}}"
                                            ToolTipService.ToolTip="{Binding [ToolTip_OpenEntry], Source={StaticResource Loc}}"
                                            Click="OnOpenEntryClick"
                                            DoubleTapped="OnEntryActionDoubleTapped"
                                            GotFocus="OnEntryActionGotFocus"
                                            LostFocus="OnEntryActionLostFocus">
                                            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                        </Button>
                                        <Rectangle
                                            Width="1"
                                            Height="20"
                                            Margin="6,0"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Button
                                            x:Name="EntryCopyContentButton"
                                            Width="32" Height="32" Padding="0"
                                            AutomationProperties.Name="{Binding [Command_CopyContent], Source={StaticResource Loc}}"
                                            ToolTipService.ToolTip="{Binding [ToolTip_CopyEntryContent], Source={StaticResource Loc}}"
                                            Visibility="{Binding Content.ContentActionVisibility}"
                                            Click="OnCopyEntryContentClick"
                                            DoubleTapped="OnEntryActionDoubleTapped"
                                            GotFocus="OnEntryActionGotFocus"
                                            LostFocus="OnEntryActionLostFocus">
                                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                        </Button>
                                        <Button
                                            x:Name="EntryCopyPathButton"
                                            Width="32" Height="32" Padding="0"
                                            AutomationProperties.Name="{Binding [Command_CopyPath], Source={StaticResource Loc}}"
                                            ToolTipService.ToolTip="{Binding [ToolTip_CopyEntryPath], Source={StaticResource Loc}}"
                                            Click="OnCopyEntryPathClick"
                                            DoubleTapped="OnEntryActionDoubleTapped"
                                            GotFocus="OnEntryActionGotFocus"
                                            LostFocus="OnEntryActionLostFocus">
                                            <FontIcon FontSize="14" Glyph="&#xE71B;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <StackPanel
                        x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding [State_EmptyBasket], Source={StaticResource Loc}}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [State_EmptyHint], Source={StaticResource Loc}}" />
                        <Button
                            Margin="0,8,0,0"
                            Click="OnPasteClick"
                            Content="{Binding [Action_PasteFromClipboard], Source={StaticResource Loc}}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid
                x:Name="PreviewSplitter"
                Grid.Column="3"
                Background="Transparent">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <primitives:Thumb
                    x:Name="PreviewSplitterThumb"
                    Background="Transparent"
                    BorderThickness="0"
                    DragDelta="OnPreviewSplitterDragDelta"
                    DragCompleted="OnPreviewSplitterDragCompleted"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid
                x:Name="PreviewHost"
                Grid.Column="4"
                Margin="8,0,0,0">
                <Grid Margin="0,0,4,8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="PreviewTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PreviewMeta"
                        Grid.Row="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Image
                            x:Name="PreviewImage"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <TextBox
                            x:Name="PreviewText"
                            AcceptsReturn="True"
                            AutomationProperties.Name="{Binding [Label_TextPreview], Source={StaticResource Loc}}"
                            Background="Transparent"
                            BorderThickness="0"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="PreviewPlaceholder"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [Preview_Placeholder], Source={StaticResource Loc}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="16,12,16,12"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QuickNoteTextBox"
                Grid.Column="0"
                AutomationProperties.Name="{Binding [Label_QuickNote], Source={StaticResource Loc}}"
                Header="{Binding [Label_QuickNote], Source={StaticResource Loc}}"
                KeyDown="OnQuickNoteKeyDown"
                PlaceholderText="{Binding [Placeholder_QuickNote], Source={StaticResource Loc}}" />

            <Button
                x:Name="QuickNoteSaveButton"
                Grid.Column="1"
                Padding="16,6"
                VerticalAlignment="Bottom"
                Click="OnSaveNoteClick"
                Content="{Binding [Action_Add], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [ToolTip_SaveNote], Source={StaticResource Loc}}" />
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="3"
            Margin="16,0,16,8"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Border
            Grid.Row="4"
            Padding="16,6,16,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="BasketPathText"
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    MaxWidth="360"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
