<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PasteHatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PasteHatch">

    <!-- Standard WinUI 3 layout built from default Fluent controls only:
         TabView (baskets) + CommandBar (commands) + ListView (materials) +
         TextBox/Button (quick note) + InfoBar (status) + status bar (path/count).
         The app follows the system light/dark theme. -->
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragEnter="OnRootDragEnter"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="BasketsTabView"
            Grid.Row="0"
            Margin="16,8,16,0"
            AddTabButtonClick="OnAddTabButtonClick"
            AutomationProperties.Name="Корзины контекста"
            CanDragTabs="False"
            CanReorderTabs="False"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabWidthMode="SizeToContent" />

        <CommandBar
            x:Name="BasketCommandBar"
            Grid.Row="1"
            Margin="8,0,8,0"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                x:Name="PasteButton"
                Click="OnPasteClick"
                Icon="Paste"
                Label="Вставить"
                ToolTipService.ToolTip="Вставить из буфера обмена (Ctrl+V)" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="OpenFolderButton"
                Click="OnOpenFolderClick"
                Icon="Folder"
                Label="Открыть папку" />
            <AppBarButton
                x:Name="CopyPathButton"
                Click="OnCopyPathClick"
                Icon="Copy"
                Label="Скопировать путь" />
            <AppBarButton
                x:Name="SettingsButton"
                Click="OnSettingsClick"
                Icon="Setting"
                Label="Настройки" />
        </CommandBar>

        <Grid Grid.Row="2" Margin="16,4,16,0">
            <ListView
                x:Name="MaterialsList"
                Padding="0,4,0,8"
                AutomationProperties.Name="Содержимое корзины"
                IsItemClickEnabled="False"
                KeyDown="OnMaterialsKeyDown"
                RightTapped="OnMaterialsRightTapped"
                SelectionChanged="OnMaterialSelectionChanged"
                SelectionMode="Single">
                <!-- Material rows are concrete data, not decoration: the default item
                     transitions (AddDeleteThemeTransition) fade the old tab's rows out and the
                     new tab's rows in roughly a second later, so a tab switch looks like a slow,
                     empty list. Clearing the collection shows the current basket immediately. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>

                <!-- Stretch the row content so the per-row copy button can sit at the right edge
                     of the item instead of right after the text (ListViewItem aligns content left
                     by default; Microsoft documents this setter for full-width row content). -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            MinHeight="48"
                            ColumnSpacing="12"
                            DoubleTapped="OnMaterialDoubleTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{Binding Glyph}"
                                VerticalAlignment="Center" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Spacing="1" Visibility="{Binding NameVisibility}">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Preview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding PreviewVisibility}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TypeLabel}"
                                        Visibility="{Binding TypeLabelVisibility}" />
                                </StackPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding EditVisibility}">
                                    <TextBox
                                        MinWidth="180"
                                        KeyDown="OnRenameBoxKeyDown"
                                        Text="{Binding EditText, Mode=TwoWay}"
                                        TextChanged="OnRenameBoxTextChanged" />
                                    <Button
                                        AutomationProperties.Name="Сохранить имя"
                                        Click="OnRenameSaveClick"
                                        Content="Сохранить" />
                                    <Button
                                        AutomationProperties.Name="Отменить переименование"
                                        Click="OnRenameCancelClick"
                                        Content="Отмена" />
                                </StackPanel>
                            </Grid>

                            <!-- Per-row copy action, right-aligned inside the list item (see Buttons
                                 guidance: a button inside a container UI is right-aligned). -->
                            <AppBarButton
                                Grid.Column="2"
                                AutomationProperties.Name="Скопировать путь к файлу"
                                Click="OnCopyMaterialPathClick"
                                Icon="Copy"
                                LabelPosition="Collapsed"
                                ToolTipService.ToolTip="Скопировать путь к файлу"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B9;"
                    HorizontalAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Корзина пуста" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Нажмите Ctrl+V или перетащите файлы в окно" />
                <Button
                    Margin="0,8,0,0"
                    Click="OnPasteClick"
                    Content="Вставить из буфера"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="3"
            Margin="16,12,16,12"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QuickNoteTextBox"
                Grid.Column="0"
                AutomationProperties.Name="Быстрая заметка"
                Header="Быстрая заметка"
                KeyDown="OnQuickNoteKeyDown"
                PlaceholderText="Введите текст и нажмите Enter" />

            <Button
                x:Name="QuickNoteSaveButton"
                Grid.Column="1"
                Padding="16,6"
                VerticalAlignment="Bottom"
                Click="OnSaveNoteClick"
                Content="Добавить"
                ToolTipService.ToolTip="Сохранить заметку (Enter)" />
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="4"
            Margin="16,0,16,8"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />

        <Border
            Grid.Row="5"
            Padding="16,6,16,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="BasketPathText"
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Text="0 файлов" />
            </Grid>
        </Border>
    </Grid>
</Window>
