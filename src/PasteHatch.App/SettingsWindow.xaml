<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PasteHatch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PasteHatch">

    <!-- Standard settings layout: grouped toggle switches with header + description, applied
         immediately (no OK/Cancel), plus an About block and a reset command. -->
    <Grid x:Name="SettingsRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="24,20,24,0">
            <StackPanel Spacing="8">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding [Settings_General], Source={StaticResource Loc}}" />

                <Grid ColumnSpacing="16" Padding="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding [Settings_Language], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [Settings_LanguageDesc], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguageCombo"
                        Grid.Column="1"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        SelectionChanged="OnLanguageSelectionChanged">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="16" Padding="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding [Settings_StartInTray], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [Settings_StartInTrayDesc], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartInTrayToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Toggled="OnStartInTrayToggled" />
                </Grid>

                <Grid ColumnSpacing="16" Padding="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding [Settings_RememberPlacement], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [Settings_RememberPlacementDesc], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="RememberPlacementToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Toggled="OnRememberPlacementToggled" />
                </Grid>

                <Grid ColumnSpacing="16" Padding="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding [Settings_AlwaysOnTop], Source={StaticResource Loc}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding [Settings_AlwaysOnTopDesc], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AlwaysOnTopToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Toggled="OnAlwaysOnTopToggled" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding [Settings_About], Source={StaticResource Loc}}" />
                <StackPanel Margin="0,8,0,8" Spacing="2">
                    <TextBlock Text="PasteHatch" />
                    <TextBlock
                        x:Name="VersionText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding [Settings_AboutDesc], Source={StaticResource Loc}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Padding="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ResetButton"
                Grid.Column="0"
                AutomationProperties.Name="{Binding [Action_ResetSettings], Source={StaticResource Loc}}"
                HorizontalAlignment="Left"
                Click="OnResetClick"
                Content="{Binding [Action_ResetSettings], Source={StaticResource Loc}}" />
            <Button
                Grid.Column="1"
                Click="OnCloseClick"
                Content="{Binding [Action_Done], Source={StaticResource Loc}}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
